# Tool settings for the OCI agent skills. Copy this file to .env (ignored by
# Git) and replace every placeholder. The scripts read .env themselves.
#
# The .env file holds two kinds of entries:
# 1. Tenancy settings (below): non-secret, required.
# 2. Agent secrets, such as GENAI_API_KEY: used only to resolve runtime.env
#    `from_env` entries of agent manifests (and, during a deploy, to mask them
#    in error messages); never added to your shell, never printed. Once you add a secret, never commit, copy, or share .env,
#    and never paste it into the chat.
#
# Never add an OCI auth token, OCI API private key, or Docker credential: OCI CLI
# and Docker keep their own credentials.
# Set OCI_AGENT_ENV_FILE to use a different file.
# Set OCI_AGENT_PYTHON to select a Python interpreter with PyYAML installed.
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_NAME=replace-with-target-compartment-name
OCIR_TENANCY_NAMESPACE=replace-with-object-storage-namespace
OCIR_USERNAME=replace-with-ocir-login-username

# Agent secrets (optional). Uncomment and set only the ones your agents use.
# GENAI_API_KEY=
