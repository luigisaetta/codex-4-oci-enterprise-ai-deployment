# Non-secret OCIR publishing configuration for the OC1 realm.
# Copy this file to .env and replace every placeholder. Never add an OCI auth
# token, password, private key, or Docker credential to either file.
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_NAME=replace-with-target-compartment-name
OCI_HOSTED_APPLICATION_NAME=hello-world
OCI_HOSTED_DEPLOYMENT_NAME=hello-world-0-1-0
OCIR_TENANCY_NAMESPACE=replace-with-object-storage-namespace
OCIR_REPOSITORY=agents/hello-world
OCIR_USERNAME=replace-with-ocir-login-username
# Optional: set only when the OCI CLI must use a non-default local profile.
# OCI_CLI_PROFILE=replace-with-oci-cli-profile
