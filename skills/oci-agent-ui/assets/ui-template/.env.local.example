# Copy this file to .env.local. Neither value is a secret.
#
# Where the agent runs:
# - local container, before the deploy: http://127.0.0.1:8080
# - deployed Hosted Application:
#   https://inference.generativeai.<region>.oci.oraclecloud.com/20251112/hostedApplications/<application-ocid>/actions/invoke
AGENT_BASE_URL=http://127.0.0.1:8080

# The agent's business endpoint, from agent-spec.md (for example /orders).
AGENT_PATH=/replace-with-agent-path
