# Copy this file to .env.local, which Git ignores.
#
# Where the agent runs:
# - local container, before the deploy: http://127.0.0.1:8080
# - deployed Hosted Application:
#   https://inference.generativeai.<region>.oci.oraclecloud.com/20251112/hostedApplications/<application-ocid>/actions/invoke
AGENT_BASE_URL=http://127.0.0.1:8080

# The agent's business endpoint, from agent-spec.md (for example /orders).
AGENT_PATH=/replace-with-agent-path

# Only for agents with the public-idcs profile (Spec 022). Leave commented for
# public-noauth agents. Copy the first two from deploy.auth in agent.yaml:
# IDCS_TOKEN_SCOPE is the audience immediately followed by the scope. Fill in
# the client ID and secret yourself; never paste them into the Codex chat.
# The local server uses them to request a token; the browser never sees them.
# IDCS_DOMAIN_URL=https://idcs-<id>.identity.oraclecloud.com:443
# IDCS_TOKEN_SCOPE=<primary-audience><scope>
# IDCS_CLIENT_ID=
# IDCS_CLIENT_SECRET=
